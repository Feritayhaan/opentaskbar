    <!-- Vector Icon DataTemplate for MenuItems -->
    <DataTemplate DataType="{x:Type Geometry}">
        <Path Data="{Binding}"
              Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
              StrokeThickness="1.6"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              Width="14"
              Height="14"
              Stretch="Uniform"
              SnapsToDevicePixels="True"
              VerticalAlignment="Center"
              HorizontalAlignment="Center" />
    </DataTemplate>
