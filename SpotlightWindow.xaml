<Window x:Class="OpenTaskbar.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar.Services"
        Title="Spotlight"
        Width="640"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource InterfaceFont}"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SpotlightItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" CornerRadius="18" Background="{DynamicResource MenuMaterial}"
            BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" RenderingBias="Performance" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Input Bar -->
            <Grid Grid.Row="0" Margin="18,14,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource IconSearch}" Width="20" Height="20" Stretch="Uniform"
                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      VerticalAlignment="Center" Margin="2,0,14,0" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderText" Text="{local:Loc SearchPlaceholder}"
                               FontSize="19" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}"
                               Opacity="0.68" IsHitTestVisible="False" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" FontSize="19" FontWeight="Normal"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="ClearButton" Visibility="Collapsed" Click="ClearButton_Click"
                            Width="24" Height="24" Cursor="Hand" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceHover}" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border Background="{DynamicResource SurfaceSelected}" BorderBrush="{DynamicResource StrokeSubtle}"
                            BorderThickness="1" CornerRadius="6" Padding="7,3">
                        <TextBlock Text="Alt+Space" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource MenuDivider}" />

            <!-- Results List -->
            <Grid Grid.Row="2">
                <ListBox x:Name="ResultsList" MaxHeight="380" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource SpotlightItemStyle}"
                         Padding="0,6"
                         PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                         MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="18,8,18,3" Opacity="0.85" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border CornerRadius="7" ClipToBounds="True">
                                        <Image Source="{Binding Icon}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <Border CornerRadius="8"
                                            Background="{Binding GlyphBackground, TargetNullValue={StaticResource SurfaceHover}}"
                                            Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}">
                                        <Path Data="{Binding Glyph}" Width="16" Height="16" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Opacity="0.72"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↵" FontSize="12" VerticalAlignment="Center"
                                           Margin="6,0,4,0" Opacity="0.7"
                                           Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyStateText" Text="{local:Loc NoResults}" Visibility="Collapsed"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,28,0,28" />
            </Grid>

            <!-- Action Hint Footer -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceSelected}"
                    BorderBrush="{DynamicResource MenuDivider}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,18,18" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}">
                            <Run Text="↵ " FontWeight="SemiBold" /><Run Text="{local:Loc HintOpen}" />
                            <Run Text="   ·   Ctrl+↵ " FontWeight="SemiBold" /><Run Text="{local:Loc HintReveal}" />
                            <Run Text="   ·   ↑↓ " FontWeight="SemiBold" /><Run Text="{local:Loc HintNavigate}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                        <Run Text="Esc " FontWeight="SemiBold" /><Run Text="{local:Loc HintClose}" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
