<Window x:Class="OpenTaskbar.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource InterfaceFont}"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="Card" Margin="14" CornerRadius="16" Padding="14,12"
            Background="{DynamicResource MenuMaterial}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1"
            MouseLeftButtonUp="Card_Click" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96" />
                <TranslateTransform x:Name="CardTranslate" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" RenderingBias="Performance" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentBrush}" Margin="0,0,11,0" VerticalAlignment="Top">
                <Path x:Name="ToastGlyph" Width="16" Height="16" Stretch="Uniform"
                      Stroke="{DynamicResource AccentText}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ToastTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ToastMessage" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap" MaxHeight="48" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
